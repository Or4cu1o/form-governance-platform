# ---------------------------------------------------------------------------
# FormOps — Variáveis de ambiente (copie para .env e preencha os valores reais)
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
# DATABASE_URL e derivada automaticamente (docker-compose.yml usa host "postgres";
# scripts/manage.js deriva "localhost:POSTGRES_PORT" para o fluxo nativo/npm start)
POSTGRES_USER=formops
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=formops
POSTGRES_PORT=5432
# Senha da role de aplicacao "formops_app" (T035) — privilegio minimo,
# sem posse de tabela, sem UPDATE/DELETE nas 6 tabelas append-only. Distinta
# de POSTGRES_PASSWORD (role "formops", dona das tabelas, usada so por
# migracao/seed). APP_DATABASE_URL e derivada automaticamente a partir
# desta senha, mesma logica de DATABASE_URL acima.
APP_DB_PASSWORD=change-me-to-a-strong-password
# Senha da role "tableau_ro" (T020/T151) — SELECT-only em "analytics",
# consumida pelo Tableau (ou outro BI) e pelos testes de integracao da
# camada analitica. TABLEAU_RO_DATABASE_URL e derivada automaticamente,
# mesma logica de APP_DATABASE_URL acima.
TABLEAU_RO_DB_PASSWORD=change-me-to-a-strong-password

# --- Object Storage (MinIO em dev / S3 em prod) ---
# S3_ENDPOINT e derivada automaticamente, mesma logica do DATABASE_URL acima
MINIO_ROOT_USER=formops
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=formops-evidencias
S3_ACCESS_KEY=formops
S3_SECRET_KEY=change-me-to-a-strong-password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Buckets com ciclo de vida distinto (D7, research.md): upload aterrissa em
# quarentena (mutavel), so promove ao imutavel (Object Lock) apos veredito
# LIBERADO do antivirus. Provisionados por scripts/provision-buckets.ts.
S3_BUCKET_QUARANTINE=formops-evidencias-quarentena
S3_BUCKET_IMMUTABLE=formops-evidencias-imutavel

# --- Antivirus (ClamAV) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Selo de integridade (Ed25519) ---
# A chave privada NUNCA entra aqui nem no repositorio — apenas a
# referencia ao arquivo montado. Ver README "Custodia da chave de selagem".
SEALING_PRIVATE_KEY_PATH=/run/secrets/sealing-active.pem
SEALING_KEY_ID=seal-2026-01

# --- Resolver de evidencia exposto ao BI (US8) ---
EVIDENCE_RESOLVER_HMAC_SECRET=change-me-to-a-long-random-string

# --- Autenticacao ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Admin inicial (provisionado no primeiro start em producao) ---
INITIAL_ADMIN_MATRICULA=00001
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- E-mail transacional ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FormOps <no-reply@example.com>"

# --- Portas da aplicacao ---
# VITE_API_URL e derivada de API_PORT automaticamente (docker-compose.yml e vite.config.ts)
API_PORT=7442
WEB_PORT=7443

# --- CORS (T171) ---
# Origem exata da SPA — sessao vive em cookie (T032), e requisicao com
# credencial nao pode carregar Access-Control-Allow-Origin curinga. Ajustar
# se WEB_PORT mudar; multiplas origens vao separadas por virgula.
CORS_ORIGIN=http://localhost:7443

# --- Seeds de desenvolvimento ---
NODE_ENV=development
SEED_ON_START=true
SEED_PROPRIETARY_FORMS=true
SEED_DEMO_POP=true
